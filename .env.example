# ==============================================================================
# STUDYFLOW AI — Environment Variables
# SAIS LABS | Production & Local Configuration
# ==============================================================================

# Supabase Credentials (Required for full cloud sync & authentication)
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Optional: Supabase Service Role Key (Server-side administrative tasks only)
# NEVER expose this key to client-side code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI Planner Integration (Optional - App includes full rule-based fallback if absent)
# Supported: Google Gemini API Key or OpenAI API Key
# For Gemini: Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
# Or for OpenAI:
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Site URL for Auth Redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
